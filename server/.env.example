# Copy this file to server/.env and fill in real values, then run
# `docker compose up -d --build` from the repo root — docker-compose.yml
# passes everything here straight into the container as env vars (no code
# change needed, nothing here is baked into the image).

# ---- Login ----
# Usernames are plain text (not secret) and default to "admin"/"user" if
# left blank. Passwords are base64-encoded, not plain text — this is NOT
# encryption (trivially reversible), just keeps the literal password from
# being readable at a glance in this file. Encode with:
#   echo -n 'the real password' | base64
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
USER_USERNAME=user
USER_PASSWORD=

# ---- Storage (Postgres) ----
# This one file feeds both the "postgres" and "vertex" services in
# docker-compose.yml, so POSTGRES_USER/PASSWORD/DB and the matching parts
# of DATABASE_URL must be the same values — docker-compose doesn't cross-
# reference them for you. "postgres" below is the other service's name,
# resolved over the compose network; leave it as-is unless you rename that
# service too.
POSTGRES_USER=vertex
POSTGRES_PASSWORD=
POSTGRES_DB=vertex
DATABASE_URL=postgres://vertex:<same password as POSTGRES_PASSWORD>@postgres:5432/vertex

# ---- Symphony ----
# Fill these in for real Symphony data instead of mock — nothing
# Symphony-related needs to be baked into the client at build time (no
# .env.local required), since the token exchange happens here on the
# server. Password is base64-encoded, same as the login passwords above.
SYMPHONY_CUSTOMER_CODE=
SYMPHONY_USERNAME=
SYMPHONY_PASSWORD=
# Only needed if Symphony's real hosts differ from the defaults baked into
# server/src/symphonyProxy.ts.
# SYMPHONY_TOKEN_UPSTREAM=
# SYMPHONY_DND_UPSTREAM=
