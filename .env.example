# Copy this file to .env.local (Vite loads it automatically, and it's
# already git-ignored) to override any of these — but for a normal setup
# you shouldn't need to. Symphony's real credentials (customer code,
# username, password) live server-side now — see server/.env.example —
# never in this file or the client bundle, so this file usually doesn't
# need to exist at all. These two just default to this app's own backend
# proxy paths (server/src/symphonyProxy.ts); only touch them if you're
# pointing somewhere other than that proxy for some reason.

# ---- Symphony (optional — both already default correctly) ----
VITE_SYMPHONY_BASE_URL=/api/symphony-dnd
VITE_SYMPHONY_TOKEN_URL=/api/symphony-auth/token
# A static token instead of the proxy's token exchange — leave empty
# unless you specifically need this.
VITE_SYMPHONY_API_TOKEN=

# ---- DevOps board: Azure DevOps (if you use it) ----
# No env vars here — sign in as admin and use the in-app Settings page
# instead. Organization, project and the personal access token are stored
# server-side (see server/src/azureDevOps.ts); the PAT never ships to the
# browser the way a VITE_* var would.

# ---- DevOps board: Jira (if you use it) ----
VITE_JIRA_BASE_URL=
VITE_JIRA_EMAIL=
VITE_JIRA_API_TOKEN=
