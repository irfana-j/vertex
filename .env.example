# Copy this file to .env.local (Vite loads it automatically, and it's
# already git-ignored) and fill in real values to point this app at your
# actual Symphony and DevOps board instances instead of the mock data in
# src/lib/symphonyConnector.ts and src/lib/devopsConnector.ts.
#
# IMPORTANT — read before filling this in:
# Vite bakes every VITE_* variable into the JavaScript bundle that ships
# to the browser. Anyone who opens this app's dev tools can read them.
# That's fine for a base URL, but NEVER put a real Symphony API token
# here if this app is going to be shared — that would hand your
# credentials to every viewer. This app's own backend (server/) already
# proxies Symphony calls server-side (see server/src/symphonyProxy.ts),
# so point the two URLs below at ITS same-origin paths —
# /api/symphony-dnd and /api/symphony-auth/token — rather than at
# Symphony's real hosts directly; the browser never talks to Symphony
# itself. The username/password/customer code below still ride along in
# the client's token-exchange request body, though, so this app is only
# as safe as whoever can reach it and open dev tools.

# ---- Symphony ----
VITE_SYMPHONY_BASE_URL=/api/symphony-dnd
# Either a static token:
VITE_SYMPHONY_API_TOKEN=
# ...or a token exchanged at request time via Basic auth (used when
# VITE_SYMPHONY_API_TOKEN above is left empty) — see getSymphonyBearerToken()
# in src/lib/symphonyConnector.ts:
VITE_SYMPHONY_TOKEN_URL=/api/symphony-auth/token
VITE_SYMPHONY_CUSTOMER_CODE=
VITE_SYMPHONY_USERNAME=
# base64-encoded, not plain text — symphonyConnector.ts decodes it before
# use. This is NOT encryption (trivially reversible), just keeps the
# literal password from being readable at a glance in this file. Encode
# with: echo -n 'the real password' | base64
VITE_SYMPHONY_PASSWORD=
# Reserved — not wired into any connector function yet. Fill these in and
# point them out in src/lib/symphonyConnector.js once you know what each
# one actually expects/returns (e.g. does the login URL replace the Basic
# auth token exchange above, or run before it; is the serverless URL a
# second base URL for a subset of endpoints, like jobs):
VITE_SYMPHONY_LOGIN_URL=
VITE_SYMPHONY_SERVERLESS_URL=

# ---- DevOps board: Azure DevOps (if you use it) ----
# No env vars here — sign in as admin and use the in-app Settings page
# instead. Organization, project and the personal access token are stored
# server-side (see server/src/azureDevOps.ts); the PAT never ships to the
# browser the way a VITE_* var would.

# ---- DevOps board: Jira (if you use it) ----
VITE_JIRA_BASE_URL=
VITE_JIRA_EMAIL=
VITE_JIRA_API_TOKEN=
